# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Datasets — 78 MB, fetched by scripts/fetch_data.ps1
data/

# Local four-task benchmark data (generated by prepare_test_benchmark.py).
# Keep test/README.md trackable, but never stage the JPEGs/annotations/CSVs.
test/VisDrone2019-*/
test/benchmark_manifest.json

# Input footage. Dropped in by hand, ~200 MB a clip: one `git add -A` away from
# being committed by accident.
video/

# Run outputs. Must be `results/*` not `results/`: git cannot re-include a file
# inside an excluded directory, so the .gitkeep would never be tracked.
results/*
!results/.gitkeep

# Generated media (regenerate with scripts/make_clip.py)
assets/*.mp4
assets/*.avi
*.png
!docs/img/*.png

# Ultralytics side effects
runs/
*.onnx.meta.json.bak
yolo*.pt
!models/yolov8n_visdrone.pt

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# AI Hub artefacts and calibration tensors (regenerate; calibration.npy is 1.2 GB)
models/_q*/
models/*.zip
results/calib/

# AI Hub compiled context binaries (11 MB; re-download from the job IDs in docs/QUANTIZATION.md)
models/_ctx/

# ONNX da train (10-12 MB moi cai; lay tu Drive hoac export lai)
models/new/

# Training-run folders (models/<name>-encoder/). A `git add -A` here would
# commit 121 MB: .pt checkpoints at 5-17 MB each, .onnx at ~10 MB, and the
# train/val batch mosaics at 0.6 MB apiece. None of it is reviewable in a diff
# and all of it is reproducible from the notebook.
#
# What stays is the evidence: summary.json (mAP per class), export.json (the
# shapes and hashes the pipeline is checked against), args.yaml (the exact
# training run) and results.csv (the loss curves). Roughly 10 KB per model,
# and the only part a reader of the thesis actually needs.
models/*/weights/
models/**/*.onnx
models/**/*.pt
models/**/*.jpg
models/**/*.jpeg
models/*.bin
!models/*/summary.json
!models/*/export.json
!models/*/args.yaml
!models/*/results.csv

# Local test/benchmark corpus: 3.3 GB of VisDrone frames and MOT sequences.
test/
